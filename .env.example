# Required: the Agent uses the LLM for intent recognition and routing.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional: raises GitHub REST API rate limits for intelligence collection.
GITHUB_TOKEN=

# Optional model endpoint overrides used by some data-processing scripts.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
